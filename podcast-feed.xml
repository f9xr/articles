---
layout: null
permalink: /podcast-feed.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
     xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd"
     xmlns:content="http://purl.org/rss/1.0/modules/content/"
     xmlns:atom="http://www.w3.org/2005/Atom"
     xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>F9XR Articles Podcast</title>
    <link>{{ '/episodes/' | absolute_url }}</link>
    <language>en-us</language>
    <description>Audio episodes on web architecture, AI integration, local SEO, and high-performance digital systems from the F9XR Team.</description>
    <itunes:author>F9XR Editorial Team</itunes:author>
    <itunes:summary>Audio episodes on web architecture, AI integration, local SEO, and high-performance digital systems from the F9XR Team.</itunes:summary>
    <itunes:type>episodic</itunes:type>
    <itunes:explicit>false</itunes:explicit>
    <itunes:category text="Technology">
      <itunes:category text="Tech News"/>
    </itunes:category>
    <itunes:category text="Business">
      <itunes:category text="Entrepreneurship"/>
    </itunes:category>
    <itunes:image href="{{ '/logo.webp' | absolute_url }}"/>
    <atom:link href="{{ '/podcast-feed.xml' | absolute_url }}" rel="self" type="application/rss+xml"/>

    {% assign sorted_episodes = site.episodes | sort: "date" | reverse %}
    {% for episode in sorted_episodes %}
    <item>
      <title>{{ episode.title | xml_escape }}</title>
      <link>{{ episode.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ episode.url | absolute_url }}</guid>
      <pubDate>{{ episode.date | date_to_rfc822 }}</pubDate>
      <description>{{ episode.description | xml_escape }}</description>
      <content:encoded><![CDATA[{{ episode.content }}]]></content:encoded>
      <itunes:title>{{ episode.title | xml_escape }}</itunes:title>
      <itunes:summary>{{ episode.description | xml_escape }}</itunes:summary>
      <itunes:duration>{{ episode.audio_duration }}</itunes:duration>
      <itunes:explicit>false</itunes:explicit>
      {% if episode.episode_number %}<itunes:episode>{{ episode.episode_number }}</itunes:episode>{% endif %}
      {% if episode.season %}<itunes:season>{{ episode.season }}</itunes:season>{% endif %}
      <enclosure url="{{ episode.audio | absolute_url }}" length="{{ episode.audio_bytes | default: 0 }}" type="{{ episode.audio_type | default: 'audio/mpeg' }}"/>
      {% if episode.image %}<itunes:image href="{{ episode.image | absolute_url }}"/>{% endif %}
      {% for tag in episode.tags %}<category>{{ tag }}</category>{% endfor %}
    </item>
    {% endfor %}
  </channel>
</rss>
