source "https://rubygems.org"

gem "jekyll", "~> 4.3"
gem "webrick", "~> 1.8"
# `theme: minima` in _config.yml. GitHub Pages ships it, but local builds and
# `bundle install` need it declared.
gem "minima", "~> 2.5"

group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.12"
  gem "jekyll-sitemap", "~> 1.4"
end

# Required by Jekyll's `timezone:` config on Windows (jekyll/utils/win_tz.rb).
# Harmless on Linux/macOS, where TZ is read from the environment instead.
gem "tzinfo", "~> 2.0"
gem "tzinfo-data", "~> 1.2026"

