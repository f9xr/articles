---
layout: null
---
{
  "version": "https://jsonfeed.org/version/1.1",
  "title": "{{ site.title | escape }}",
  "description": "{{ site.description | escape }}",
  "home_page_url": "{{ '/' | absolute_url }}",
  "feed_url": "{{ '/feed.json' | absolute_url }}",
  "authors": [
    {
      "name": "{{ site.author | escape }}",
      "url": "https://f9xr.github.io"
    }
  ],
  "items": [
    {% for post in site.posts limit:20 %}
    {
      "id": "{{ post.url | absolute_url }}",
      "url": "{{ post.url | absolute_url }}",
      "title": "{{ post.title | escape }}",
      "content_html": {{ post.content | jsonify }},
      "summary": "{{ post.description | escape }}",
      "date_published": "{{ post.date | date_to_xmlschema }}",
      "date_modified": "{{ post.dateModified | default: post.date | date_to_xmlschema }}",
      "authors": [
        {
          "name": "{{ post.author | default: site.author | escape }}"
        }
      ],
      "tags": [{% for tag in post.tags %}"{{ tag | escape }}"{% unless forloop.last %},{% endunless %}{% endfor %}]
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
